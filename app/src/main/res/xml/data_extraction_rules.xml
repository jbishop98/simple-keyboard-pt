<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and newer. Learned words and imported dictionaries stay on the
     device: they are neither uploaded to cloud backup nor copied to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="history/" />
        <exclude domain="device_file" path="dicts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="history/" />
        <exclude domain="device_file" path="dicts/" />
    </device-transfer>
</data-extraction-rules>
